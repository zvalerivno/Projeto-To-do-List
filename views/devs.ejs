      <!-- ========== DEV 1 ========== -->
      <section class="sobre-section">
        <div class="dev-container">

          <!-- FOTO: salve a imagem em public/img/ e coloque o nome do arquivo no src -->
          <div class="dev-foto">
            <img src="/img/Theus.jpeg" alt="Matheus">
          </div>

          <div class="dev-info">
            <span class="sobre-kicker">Desenvolvedor</span>

            <!-- NOME -->
            <h2 class="sobre-h2">Matheus</h2>

            <!-- TEXTO CURTO -->
            <p class="dev-texto">Matheus é um desenvolvedor web de 17 anos, nascido em 20 de agosto de 2009 e morador de Guaianases, São Paulo. Ele faz parte do desenvolvimento do projeto TarefaFlow. No projeto, Matheus foi responsável pelo desenvolvimento das páginas Devs, Login e Menu, contribuindo para a estrutura, organização e funcionamento do site. O TarefaFlow tem como objetivo facilitar o gerenciamento e a organização de tarefas de forma simples e prática.</p>

            <!-- PARTES QUE DESENVOLVEU (um <li> para cada parte) e o INSTAGRAM, na mesma linha -->
            <div class="dev-linha">
            <ul class="dev-partes">
              <li>Devs</li>
              <li>Login</li>
              <li>Menu</li>
            </ul>

            <!-- INSTAGRAM: troque "usuario" pelo @ da pessoa -->
            <a class="dev-instagram" href="https://www.instagram.com/xstheuz/" target="_blank">
              <i class="fab fa-instagram"></i>
            </a>
            </div>
          </div>

        </div>
      </section>

